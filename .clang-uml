compilation_database_dir: ./build
output_directory: diagrams
diagrams:
  SimpleFactory_class:
    type: class
    glob:
      - src/SimpleFactory.cpp
    using_namespace: clanguml::SimpleFactory
    include:
      namespaces:
        - clanguml::SimpleFactory
    plantuml:
      after:
        - 'note left of {{ alias("DoorFactory") }}: Factory entrance'
  FactoryMethod_class:
    type: class
    glob:
      - src/FactoryMethod.cpp
    using_namespace: clanguml::FactoryMethod
    include:
      namespaces:
        - clanguml::FactoryMethod
    plantuml:
      after:
        - 'note left of {{ alias("clanguml::FactoryMethod::ProtocolFactory") }}: Factory entrance'
  AbstractFactory_class:
    type: class
    glob:
      - src/AbstractFactory.cpp
    using_namespace: clanguml::AbstractFactory
    include:
      namespaces:
        - clanguml::AbstractFactory
    plantuml:
      after:
        - 'note left of {{ alias("clanguml::AbstractFactory::ProtocolFactory") }}: Factory entrance'
  Builder_class:
    type: class
    glob:
      - src/Builder.cpp
    using_namespace: clanguml::Builder
    include:
      namespaces:
        - clanguml::Builder
    plantuml:
      after:
        - 'note left of {{ alias("clanguml::Builder::BurgerBuilder") }}: Interface for building burgers'
  Prototype_class:
    type: class
    glob:
      - src/Prototype.cpp
    using_namespace: clanguml
    include:
      namespaces:
        - clanguml
    plantuml:
      after:
         - ' '